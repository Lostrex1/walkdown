{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkdown.dev/schemas/config/v1.json",
  "title": "Walkdown configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "outputDir": { "type": "string", "minLength": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "maxDepth": { "type": "integer", "minimum": 0, "maximum": 20 },
    "include": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedOrigins": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace": { "type": "boolean" },
        "settleMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "userAgent": { "type": "string", "minLength": 1 }
      }
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActions": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "crawlTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maxQueryVariantsPerPath": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "allowExternalNavigation": { "type": "boolean" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "failOn": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["info", "warning", "error", "blocking"] }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeholders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "navigation.placeholder-link": {
              "$ref": "#/$defs/basicRule"
            },
            "navigation.broken-internal-link": {
              "$ref": "#/$defs/urlRule"
            },
            "runtime.page-error": {
              "$ref": "#/$defs/messageRule"
            },
            "runtime.console-error": {
              "$ref": "#/$defs/messageRule"
            },
            "runtime.failed-request": {
              "$ref": "#/$defs/requestRule"
            },
            "interaction.dead-control": {
              "$ref": "#/$defs/basicRule"
            },
            "interaction.pseudo-control": {
              "$ref": "#/$defs/basicRule"
            },
            "responsive.horizontal-overflow": {
              "$ref": "#/$defs/basicRule"
            },
            "interaction.obstructed-control": {
              "$ref": "#/$defs/basicRule"
            },
            "accessibility.missing-name": {
              "$ref": "#/$defs/basicRule"
            },
            "accessibility.keyboard-focus": {
              "$ref": "#/$defs/basicRule"
            },
            "accessibility.modal-focus": {
              "$ref": "#/$defs/basicRule"
            }
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowButtonClicks": { "type": "boolean" },
            "effectTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "stabilityMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "layoutSettleMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxControlsPerPage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "keyboardMaxSteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "dynamicSelectors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "ignoreRequestPatterns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "basicRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": {
          "enum": ["info", "warning", "error", "blocking"]
        }
      }
    },
    "messageRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": {
          "enum": ["info", "warning", "error", "blocking"]
        },
        "ignoreMessagePatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "urlRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": {
          "enum": ["info", "warning", "error", "blocking"]
        },
        "ignoreUrlPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requestRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": {
          "enum": ["info", "warning", "error", "blocking"]
        },
        "ignoreMessagePatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ignoreUrlPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
