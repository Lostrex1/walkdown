{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkdown.dev/schemas/config/v1.json",
  "title": "Walkdown configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "outputDir": { "type": "string", "minLength": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "maxDepth": { "type": "integer", "minimum": 0, "maximum": 20 },
    "include": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedOrigins": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace": { "type": "boolean" },
        "settleMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "userAgent": { "type": "string", "minLength": 1 }
      }
    }
  }
}
