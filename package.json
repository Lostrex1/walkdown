{
  "name": "walkdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "action:build": "node scripts/build-action.mjs",
    "action:check": "npm run action:build && git diff --exit-code -- packages/action/dist",
    "dev": "tsx packages/cli/src/main.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
